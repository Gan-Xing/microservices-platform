    },
    "shared": {
      "name": "shared",
      "root": "libs/shared",
      "sourceRoot": "libs/shared/src",
      "projectType": "library",
      "targets": {}
    },
    "common": {
      "name": "common",
      "root": "libs/common",
      "sourceRoot": "libs/common/src",
      "projectType": "library",
      "targets": {}
    },
    "types": {
