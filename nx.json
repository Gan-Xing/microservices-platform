      "projectType": "application",
      "targets": {}
    },
    "monitoring-service": {
      "name": "monitoring-service",
      "root": "apps/monitoring-service",
      "sourceRoot": "apps/monitoring-service/src",
      "projectType": "application",
      "targets": {}
    },
    "audit-service": {
      "name": "audit-service",
      "root": "apps/audit-service", 
      "sourceRoot": "apps/audit-service/src",
      "projectType": "application",
      "targets": {}
    },
    "scheduler-service": {
      "name": "scheduler-service",
      "root": "apps/scheduler-service",
      "sourceRoot": "apps/scheduler-service/src",
      "projectType": "application",
      "targets": {}
    },
    "message-queue-service": {
      "name": "message-queue-service",
      "root": "apps/message-queue-service",
      "sourceRoot": "apps/message-queue-service/src",
