{
  "name": "platform",
  "version": "1.0.0",
  "description": "企业级微服务平台 - 支持100租户+10万用户的标准版本",
  "keywords": ["microservices", "nestjs", "nx", "enterprise", "platform"],
  "license": "MIT",
  "author": "Platform Team",
  "homepage": "https://github.com/yourcompany/platform",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourcompany/platform.git"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.4",
  "scripts": {
    "start": "nx serve",
    "build": "nx build",
    "test": "nx test",
    "test:e2e": "nx e2e",
    "lint": "nx lint",
    "format": "nx format:write",
    "format:check": "nx format:check",
    "affected:build": "nx affected:build",
    "affected:test": "nx affected:test",
    "affected:lint": "nx affected:lint",
    "dep-graph": "nx dep-graph",
    "workspace-graph": "nx graph",
    "reset": "nx reset",
    "clean": "nx run-many --target=clean --all",
    "prisma:generate": "nx run-many --target=prisma:generate --all",
    "prisma:migrate": "nx run-many --target=prisma:migrate --all",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "infrastructure:start": "docker-compose up -d postgres redis prometheus grafana minio",
    "infrastructure:stop": "docker-compose stop postgres redis prometheus grafana minio",
    "services:start": "nx run-many --target=serve --projects=api-gateway-service,auth-service,user-management-service",
    "services:build": "nx run-many --target=build --all",
    "services:test": "nx run-many --target=test --all",
    "dev": "pnpm infrastructure:start && pnpm services:start",
    "setup": "pnpm install && pnpm prisma:generate && pnpm infrastructure:start"
  },
  "devDependencies": {
    "@nestjs/schematics": "^10.0.1",
    "@nestjs/testing": "^10.0.2",
    "@nx/cypress": "17.2.8",
    "@nx/eslint": "17.2.8",
    "@nx/eslint-plugin": "17.2.8",
    "@nx/jest": "17.2.8",
    "@nx/js": "17.2.8",
    "@nx/nest": "17.2.8",
    "@nx/node": "17.2.8",
    "@nx/workspace": "17.2.8",
    "@types/jest": "^29.4.0",
    "@types/node": "~18.16.9",
    "@typescript-eslint/eslint-plugin": "^6.9.1",
    "@typescript-eslint/parser": "^6.9.1",
    "eslint": "~8.46.0",
    "eslint-config-prettier": "9.0.0",
    "jest": "^29.4.1",
    "jest-environment-node": "^29.4.1",
    "nx": "17.2.8",
    "prettier": "^2.6.2",
    "ts-jest": "^29.1.0",
    "ts-node": "10.9.1",
    "typescript": "~5.2.2"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.2",
    "@nestjs/core": "^11.1.18",
    "@nestjs/jwt": "^10.1.0",
    "@nestjs/passport": "^10.0.0",
    "@nestjs/platform-express": "^10.0.2",
    "@nestjs/swagger": "^7.1.8",
    "@nestjs/typeorm": "^10.0.0",
    "@nestjs/config": "^3.0.0",
    "@nestjs/cache-manager": "^2.1.0",
    "@prisma/client": "^5.2.0",
    "prisma": "^5.2.0",
    "passport": "^0.6.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "bcrypt": "^5.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "redis": "^4.6.7",
    "ioredis": "^5.3.2",
    "axios": "^1.16.0",
    "rxjs": "^7.8.0",
    "reflect-metadata": "^0.1.13",
    "cache-manager": "^5.2.3",
    "helmet": "^7.0.0",
    "compression": "^1.7.4",
    "express-rate-limit": "^6.10.0",
    "winston": "^3.10.0",
    "prom-client": "^14.2.0"
  },
  "nx": {
    "includedScripts": [
      "build",
      "test",
      "lint"
    ]
  },
  "workspaces": [
    "apps/*",
    "libs/*"
  ]
}